# Optional. Leave BOTH empty to keep guest-only operation.
# Use HTTPS Project URL and the public sb_publishable_ key from Supabase Connect.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Independent release switches. Set false and rebuild to hide/block a new mode.
# Empty/unset keeps current behavior (enabled); basic exercises are always available.
VITE_ENABLE_OPPOSITION=
VITE_ENABLE_RING=
